{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pms-panel-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://pms-panel-api.onrender.com/auth/:path*" },
    { "source": "/panel/:path*", "destination": "https://pms-panel-api.onrender.com/panel/:path*" },
    { "source": "/mentor/:path*", "destination": "https://pms-panel-api.onrender.com/mentor/:path*" },
    { "source": "/evaluation/:path*", "destination": "https://pms-panel-api.onrender.com/evaluation/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
